@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.StatusCode is not null)
{
    <p><strong>Status code:</strong> @Model.StatusCode</p>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">
        <strong>Reason:</strong> @Model.ErrorMessage
        <div class="mt-2">
            Common causes in this demo: wrong SQL connection string, or table columns not matching the repo queries.
        </div>
    </div>
}

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    Go back to <a asp-page="/Index">Home</a>.
</p>
